{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ekisa-team/sqlmux/schema/config.json",
  "title": "SQLMux Config",
  "type": "object",
  "required": ["server", "database", "api"],
  "additionalProperties": false,

  "properties": {
    "server":   { "$ref": "#/$defs/server" },
    "database": { "$ref": "#/$defs/database" },
    "api":      { "$ref": "#/$defs/api" }
  },

  "$defs": {
    "server": {
      "type": "object",
      "required": ["host", "port"],
      "additionalProperties": false,
      "properties": {
        "host": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "timeouts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "read":  { "$ref": "#/$defs/duration" },
            "write": { "$ref": "#/$defs/duration" },
            "idle":  { "$ref": "#/$defs/duration" }
          }
        }
      }
    },

    "database": {
      "type": "object",
      "required": ["driver", "url"],
      "additionalProperties": false,
      "properties": {
        "driver": { "type": "string", "enum": ["mssql", "postgres", "mysql"] },
        "url":    { "type": "string" },
        "pool": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_open_conns":     { "type": "integer", "minimum": 0 },
            "max_idle_conns":     { "type": "integer", "minimum": 0 },
            "conn_max_lifetime":  { "$ref": "#/$defs/duration" },
            "conn_max_idle_time": { "$ref": "#/$defs/duration" }
          }
        }
      }
    },

    "api": {
      "type": "object",
      "required": ["prefix", "resources"],
      "additionalProperties": false,
      "properties": {
        "prefix": { "type": "string", "pattern": "^/" },
        "resources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/resource" }
        }
      }
    },

    "resource": {
      "type": "object",
      "required": ["name", "base_path", "routes"],
      "additionalProperties": false,
      "properties": {
        "name":      { "type": "string", "minLength": 1 },
        "base_path": { "type": "string", "pattern": "^/" },
        "routes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/route" }
        }
      }
    },

    "route": {
      "type": "object",
      "required": ["method", "query", "returns"],
      "additionalProperties": false,
      "properties": {
        "method":      { "type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
        "path":        { "type": "string", "pattern": "^/" },
        "path_params": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/field" }
        },
        "body": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/field" }
        },
        "query":   { "$ref": "#/$defs/query" },
        "returns": { "type": "string", "enum": ["none", "one", "many"] }
      },
      "allOf": [
        {
          "comment": "path_params required whenever :name tokens appear in path",
          "if": {
            "properties": { "path": { "pattern": ":" } },
            "required": ["path"]
          },
          "then": { "required": ["path_params"] }
        }
      ]
    },

    "field": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type":     { "type": "string", "enum": ["string", "int", "bool", "float", "datetime"] },
        "required": { "type": "boolean", "default": false }
      }
    },

    "query": {
      "type": "object",
      "oneOf": [
        { "$ref": "#/$defs/query_sql" },
        { "$ref": "#/$defs/query_procedure" }
      ]
    },

    "query_sql": {
      "type": "object",
      "required": ["sql"],
      "additionalProperties": false,
      "properties": {
        "sql": { "type": "string", "minLength": 1 }
      }
    },

    "query_procedure": {
      "type": "object",
      "required": ["procedure"],
      "additionalProperties": false,
      "properties": {
        "procedure": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$" },
        "params": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/param_source" }
        }
      }
    },

    "param_source": {
      "type": "string",
      "description": "Reference to a declared value, e.g. path_params.id or body.name",
      "pattern": "^(path_params|body)\\.[A-Za-z_][A-Za-z0-9_]*$"
    },

    "duration": {
      "type": "string",
      "description": "Go duration string, e.g. 10s, 30m, 1h",
      "pattern": "^[0-9]+(ns|us|µs|ms|s|m|h)$"
    }
  }
}